# ============================================================================
# 基金量化交易系统 — 环境变量配置示例
# 复制此文件为 .env 并填写实际值: cp .env.example .env
# 注意：只有本文件中列出的变量会被后端代码读取（backend/config.py）
# ============================================================================

# ── 数据库配置 ──────────────────────────────────────────────────────────
# 数据库目录（Docker 中默认 /app/data，本地开发默认 data/）
FUND_QUANT_DATABASE_DIR=data/

# 数据库文件名
FUND_QUANT_DATABASE_NAME=fund_quant.db

# ── 服务配置 ──────────────────────────────────────────────────────────
# 监听地址（Docker 中必须为 0.0.0.0）
FUND_QUANT_HOST=0.0.0.0

# 监听端口
FUND_QUANT_PORT=8000

# 调试模式（生产环境设为 false）
FUND_QUANT_DEBUG=false

# ── CORS 配置 ────────────────────────────────────────────────────────
# 允许的跨域来源，多个用逗号分隔
# Docker 部署时需包含 nginx 所在域
FUND_QUANT_CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000

# ── JoinQuant 数据源（可选）─────────────────────────────────────────────
# JoinQuant 账号（https://www.joinquant.com 注册获取），留空则跳过该数据源
JOINQUANT_USER=
JOINQUANT_PASSWORD=

# ────────────────────────────────────────────────────────────────────────
# 以下配置不在 .env 中设置（后端代码不读取，写在 .env 无效）：
#
# - AI API Key / 模型 / Base URL：通过 Web 界面「系统配置」设置（存 system_config 表）
# - 飞书推送 Webhook：通过 Web 界面「推送渠道」设置（存 push_channel 表）
# ============================================================================
